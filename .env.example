# Most GVC data comes from the GVC API (no key needed).
# Only uncomment these if you need them for specific features:
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Upstash Redis (optional — distributed rate limits in production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional error tracking (wire reportError to your provider)
# SENTRY_DSN=

# Neon Postgres — accounts, leaderboards, cloud progress (optional; guest mode works without it).
# Use the **pooled** connection string in production (hostname contains -pooler).
# Put the real URL in `.env.local` (Next.js loads it automatically; that file is gitignored in this repo).
DATABASE_URL="postgresql://USER:PASSWORD@HOSTNAME/neondb?sslmode=require"

# Session cookie (HTTP-only). Defaults shown — override if needed.
AUTH_COOKIE_NAME=vibe_crashers_session
AUTH_SESSION_DAYS=30

# App URL for passport links, OG assets, and share cards (production domain).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Storage — Vibe Night Passport images + public asset bucket (dev screenshots).
SUPABASE_URL=https://rcrcpvqtrrkrnyhmqilm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Production: run `npm run migrate` once per deploy instead of DDL on every API request.
# ALLOW_RUNTIME_MIGRATIONS=true
